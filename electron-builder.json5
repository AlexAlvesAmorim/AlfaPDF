{
  "appId": "com.alex.pdfreader",
  "productName": "ALFA PDF Reader",
  "copyright": "Copyright © 2026 Alex Alves Amorim. Todos os direitos reservados.",
  "asar": false,

  "directories": {
    "output": "release"
  },

  "files": [
    "out/**/*",
    "node_modules/**/*",
    "package.json"
  ],

  "publish": {
    "provider": "github",
    "owner": "AlexAlvesAmorim",
    "repo": "AlfaPDF"
  },

  "win": {
    "icon": "src/renderer/assets/logo512.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "ALFA PDF Document",
        "description": "Documento PDF - ALFA PDF Reader",
        "role": "Viewer",
        "icon": "src/renderer/assets/logo512.ico"
      }
    ]
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "shortcutName": "ALFA PDF Reader",
    "installerIcon": "src/renderer/assets/logo512.ico",
    "uninstallerIcon": "src/renderer/assets/logo512.ico",
    "installerHeaderIcon": "src/renderer/assets/logo512.ico",
    "installerHeader": "build/installer-header.bmp",
    "installerSidebar": "installer/assets/sidebar.bmp",
    "deleteAppDataOnUninstall": true,
    "displayLanguageSelector": true,
    "multiLanguageInstaller": true,
    "warningsAsErrors": true,
    "license": "LICENSE.md",
    "menuCategory": "Productivity",

    "multiSession": true,
    "displayInstallProgress": true,
    "displayUninstallProgress": true,

    "welcomePage": {
      "title": "Bem-vindo ao ALFA PDF Reader 2.0",
      "subtitle": "Visualizador PDF profissional e intuitivo",
      "description": "Leitura continua · Multiplas abas · Impressao profissional · Suporte a senhas · Atualizacao automatica"
    },

    "finishPage": {
      "title": "ALFA PDF Reader 2.0 instalado com sucesso!",
      "subtitle": "Clique em Concluir para comecar a usar o ALFA PDF Reader 2.0",
      "runButton": "Iniciar ALFA PDF Reader 2.0"
    }
  }
}